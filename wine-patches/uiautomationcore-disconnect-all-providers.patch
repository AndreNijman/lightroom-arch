@@ -2338,3 +2338,20 @@ HRESULT WINAPI UiaDisconnectProvider(IRawElementProviderSimple *elprov)
 
     return S_OK;
 }
+
+/***********************************************************************
+ *          UiaDisconnectAllProviders (uiautomationcore.@)
+ *
+ * lightroom-arch: Lightroom calls this during shutdown. Wine never
+ * exported it, so the call hit an unimplemented-stub abort and the
+ * process failed to terminate cleanly (the window-manager close
+ * shortcut and the titlebar close button both stalled here). The
+ * runtime keeps per-process provider state that is torn down at
+ * process exit anyway, so a no-op that reports success is safe and
+ * lets Lightroom's shutdown path finish normally.
+ */
+HRESULT WINAPI UiaDisconnectAllProviders(void)
+{
+    FIXME("() stub\n");
+    return S_OK;
+}
