+/* FEATURE_BROWSER_EMULATION lets a host process opt its embedded WebBrowser
+ * controls into a specific document mode via a per-executable DWORD under
+ * HKCU/HKLM ...\Internet Explorer\Main\FeatureControl\FEATURE_BROWSER_EMULATION.
+ * It is the documented Windows mechanism for a non-iexplore host (the Adobe
+ * Creative Cloud installer is one example - it sets the key for itself) to get
+ * a newer engine than the IE7 default. Honour it so such a host's browser runs
+ * in the mode it requests. */
+static BOOL get_feature_browser_emulation(compat_mode_t *r)
+{
+    static const WCHAR keypathW[] =
+        L"Software\\Microsoft\\Internet Explorer\\Main\\FeatureControl\\FEATURE_BROWSER_EMULATION";
+    const WCHAR *exe_name, *p;
+    DWORD value = 0, type, size;
+    unsigned int i;
+    HKEY key;
+
+    exe_name = NtCurrentTeb()->Peb->ProcessParameters->ImagePathName.Buffer;
+    if((p = wcsrchr(exe_name, '/'))) exe_name = p + 1;
+    if((p = wcsrchr(exe_name, '\\'))) exe_name = p + 1;
+
+    for(i = 0; i < 2; i++) {
+        if(RegOpenKeyExW(i ? HKEY_LOCAL_MACHINE : HKEY_CURRENT_USER,
+                         keypathW, 0, KEY_QUERY_VALUE, &key) != ERROR_SUCCESS)
+            continue;
+        size = sizeof(value);
+        if(RegQueryValueExW(key, exe_name, NULL, &type, (BYTE*)&value, &size) == ERROR_SUCCESS
+           && type == REG_DWORD) {
+            RegCloseKey(key);
+            /* MSDN FEATURE_BROWSER_EMULATION values: 7000 IE7, 8000/8888 IE8,
+             * 9000/9999 IE9, 10000/10001 IE10, 11000/11001 IE11. */
+            if(value >= 11000)      *r = COMPAT_MODE_IE11;
+            else if(value >= 10000) *r = COMPAT_MODE_IE10;
+            else if(value >= 9000)  *r = COMPAT_MODE_IE9;
+            else if(value >= 8000)  *r = COMPAT_MODE_IE8;
+            else if(value >= 7000)  *r = COMPAT_MODE_IE7;
+            else return FALSE;
+            TRACE("FEATURE_BROWSER_EMULATION %s -> compat mode %u\n", debugstr_w(exe_name), *r);
+            return TRUE;
+        }
+        RegCloseKey(key);
+    }
+    return FALSE;
+}
